{
  "name": "@easytz/dsh-market",
  "version": "1.0.0",
  "description": "Plugin market for DeepSeek Harness: browse npm, inspect details, install into the current profile",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "market",
    "plugin-manager",
    "sidebar-panel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EasyTZ/dsh-market.git"
  },
  "homepage": "https://github.com/EasyTZ/dsh-market#readme",
  "bugs": {
    "url": "https://github.com/EasyTZ/dsh-market/issues"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
